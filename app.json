{
  "expo": {
    "name": "expense-tracker",
    "slug": "expense-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/avatar-1.png",
    "scheme": "expensetracker",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#539E99"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Inter_400Regular.ttf",
            "./assets/fonts/Inter_500Medium.ttf",
            "./assets/fonts/Inter_600SemiBold.ttf",
            "./assets/fonts/Inter_700Bold.ttf"
          ]
        }
      ],
      "expo-asset",
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo-native-components"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "android": {
      "package": "org.authengine.expensetracker"
    },
    "ios": {
      "bundleIdentifier": "org.authengine.expensetracker"
    },
    "web": {
      "output": "static"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "b2a5b2f7-b3e7-4b3d-bc01-07f105a44261"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b2a5b2f7-b3e7-4b3d-bc01-07f105a44261"
    }
  }
}
